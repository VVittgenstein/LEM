    },
    "legacy": {
      "kind": "pytest",
      "environment": "compute",
      "paths": [
        "experiments",
        "viewer"
      ],
      "args": [
        "tests/experiments/lem_pipeline/test_pipeline_basic.py"
      ],
      "default": true,
      "description": "Existing generator regression"
    },
    "mask": {
      "kind": "unittest",
      "environment": "stages",
      "paths": [
        "data_generation/stage/mask_generator",
        "viewer"
      ],
      "test_dir": "tests/data_generation/stage/mask_generator",
      "default": true,
      "description": "mask_generator",
      "modules": [
        "test_geometry",
        "test_numerics",
        "test_report"
      ]
    },
    "seafloor": {
      "kind": "unittest",
