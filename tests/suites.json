{
  "interpreters": {
    "viewer": "lem-env-win/Scripts/python.exe",
    "compute": "lem-env/python.exe",
    "stages": "docs/work/2026-09-08-q1-data/D-landform-statistics/.venv/Scripts/python.exe"
  },
  "pytest_support": "lem-env-win/Lib/site-packages",
  "suites": {
    "viewer": {
      "kind": "pytest",
      "environment": "viewer",
      "paths": [
        "viewer"
      ],
      "args": [
        "tests/viewer"
      ],
      "default": true,
      "description": "Viewer regression"
    },
    "viewer_native": {
      "kind": "script",
      "environment": "viewer",
